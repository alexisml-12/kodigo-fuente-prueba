# Variables usadas por docker-compose para levantar todo el stack.
# Copia este archivo a ".env" y reemplaza los valores antes de ejecutar docker-compose up.

# Contraseña del usuario sa de SQL Server (mínimo 8 caracteres, mayúsculas, minúsculas, números y símbolos)
MSSQL_SA_PASSWORD=CHANGE_ME_Strong1

# Puerto donde queda expuesto el backend en el host
BACKEND_PORT=4000

# Puerto donde queda expuesto el frontend en el host
FRONTEND_PORT=5173

# Origen permitido por CORS en el backend (debe coincidir con la URL del frontend)
CORS_ORIGIN=http://localhost:5173

# URL de la API que usará el frontend (se hornea en el build de Vite)
VITE_API_URL=http://localhost:4000
