# Puerto en el que corre la API
PORT=4000

# Cadena de conexión a SQL Server para Prisma
# Formato: sqlserver://HOST:PUERTO;database=NOMBRE_DB;user=USUARIO;password=PASSWORD;trustServerCertificate=true
DATABASE_URL="sqlserver://localhost:1433;database=promociones;user=sa;password=CHANGE_ME;trustServerCertificate=true"

# Origen permitido para CORS (URL del frontend)
CORS_ORIGIN=http://localhost:5173
