generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

/// Catálogo simple de productos usado para asociar promociones,
/// ya sea a un producto puntual o a toda su categoría.
model Product {
  id         Int      @id @default(autoincrement())
  name       String   @db.NVarChar(120)
  category   String   @db.NVarChar(80)
  createdAt  DateTime @default(now()) @map("created_at")

  promotions Promotion[]

  @@map("products")
}

// Nota: SQL Server no soporta el tipo `enum` nativo de Prisma
// (a diferencia de PostgreSQL). Los siguientes valores se modelan como
// String y se validan a nivel de aplicación con Zod:
//   targetType: "PRODUCTO" | "CATEGORIA"
//   discountType: "PORCENTAJE" | "MONTO_FIJO"
//   status / fromStatus / toStatus: "PROGRAMADA" | "ACTIVA" | "FINALIZADA"

/// Promoción configurada sobre un producto o una categoría completa.
model Promotion {
  id            Int      @id @default(autoincrement())
  name          String   @db.NVarChar(120)
  targetType    String   @map("target_type") @db.NVarChar(20)
  productId     Int?     @map("product_id")
  categoryName  String?  @map("category_name") @db.NVarChar(80)
  discountType  String   @map("discount_type") @db.NVarChar(20)
  discountValue Decimal  @map("discount_value") @db.Decimal(10, 2)
  startDate     DateTime @map("start_date")
  endDate       DateTime @map("end_date")
  status        String   @default("PROGRAMADA") @db.NVarChar(20)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  product       Product?              @relation(fields: [productId], references: [id])
  statusHistory PromotionStatusLog[]

  @@map("promotions")
}

/// Historial de cambios de estado de una promoción, útil para auditoría.
model PromotionStatusLog {
  id           Int      @id @default(autoincrement())
  promotionId  Int      @map("promotion_id")
  fromStatus   String?  @map("from_status") @db.NVarChar(20)
  toStatus     String   @map("to_status") @db.NVarChar(20)
  changedAt    DateTime @default(now()) @map("changed_at")

  promotion    Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)

  @@map("promotion_status_log")
}
